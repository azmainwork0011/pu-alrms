# ═══════════════════════════════════════════════════════════════════════════════
# PU-ALRMS — Environment Variables
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (SQLite file in ./db/):
DATABASE_URL="file:./db/dev.db"
DATABASE_AUTH_TOKEN=""

# Production (Turso / LibSQL) — set via setup script or Vercel dashboard:
#   DATABASE_URL="libsql://pu-alrms-your-org.turso.io"
#   DATABASE_AUTH_TOKEN="your-turso-auth-token"

# ── Authentication ───────────────────────────────────────────────────────────
# Required. Generate with:  openssl rand -base64 32
JWT_SECRET=""
NEXTAUTH_SECRET=""

# Local vs Production URL for NextAuth callbacks:
NEXTAUTH_URL="http://localhost:3000"
# Production: NEXTAUTH_URL="https://pu-alrms.vercel.app"

# ── Google OAuth (required for Google sign-in) ───────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#                      https://pu-alrms.vercel.app/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Super Admin ──────────────────────────────────────────────────────────────
# The FIRST user to sign in with this email gets SUPER_ADMIN role automatically.
# Must be set before the user logs in for the first time.
SUPER_ADMIN_EMAIL=""

# ── AI Providers (multi-provider with fallback) ──────────────────────────────
# At least ONE provider must be configured for AI features to work.
# Fallback order: Gemini → Groq → OpenRouter

# Google Gemini (primary — free tier, best for academic tasks)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Groq (ultra-fast coding & chat — free tier available)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=""

# OpenRouter (fallback — free/open models)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# ── Phone OTP (optional — requires Twilio account) ───────────────────────────
TWILIO_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE=""

# ── App Config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PU-ALRMS"
