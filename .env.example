# ═══════════════════════════════════════════════════════════════
# PU-ALRMS Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local for local development.
# For Vercel production, add these in Project Settings → Environment Variables.
#
# IMPORTANT: Never commit your .env files to git!

# ── Database ──────────────────────────────────────────────────
# Local dev: SQLite file path
DATABASE_URL="file:./db/custom.db"
DATABASE_AUTH_TOKEN=""

# Production (Turso LibSQL):
# DATABASE_URL="libsql://pu-alrms-sini34.aws-ap-south-1.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# ── Authentication ───────────────────────────────────────────
# JWT secret for custom tokens (auto-generated if missing)
JWT_SECRET="pu-alrms-dev-secret-2024-local"

# NextAuth secret — REQUIRED for production. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="pu-alrms-nextauth-dev-secret-2024"

# Base URL of your app (auto-detected on Vercel via VERCEL_URL)
# Local dev:
NEXTAUTH_URL="http://localhost:3000"
# Production: (remove or set to your Vercel domain)
# NEXTAUTH_URL="https://pu-alrms.vercel.app"

# ── Google OAuth (REQUIRED for Google Login) ───────────────────
# Get these from: Google Cloud Console → APIs & Services → Credentials
#
# STEP 1: Create a new project (or select existing)
# STEP 2: Go to "APIs & Services" → "OAuth consent screen"
#   - User Type: External
#   - App name: PU-ALRMS
#   - User support email: your email
#   - Developer contact: your email
#   - Scopes: email, profile, openid
#   - Test users: add your email (for testing in "Testing" mode)
#   - Publish app: "Publish App" (required to go live)
#
# STEP 3: Go to "Credentials" → "Create Credentials" → "OAuth client ID"
#   - Application type: Web application
#   - Name: PU-ALRMS Web Client
#   - Authorized JavaScript origins:
#       http://localhost:3000
#       https://your-domain.vercel.app
#   - Authorized redirect URIs:
#       http://localhost:3000/api/auth/callback/google
#       https://your-domain.vercel.app/api/auth/callback/google
#
# STEP 4: Copy Client ID and Client Secret below:
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# ── Super Admin (optional) ─────────────────────────────────────
# Email address that gets SUPER_ADMIN role automatically on Google login
SUPER_ADMIN_EMAIL=""

# ── AI Providers (optional, for voice assistant) ───────────────
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# ── App Config ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PU-ALRMS"
