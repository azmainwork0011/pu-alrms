# ═══════════════════════════════════════════════════════════
# PU-ALRMS — Environment Variables
# Copy this file to .env.local and fill in your values
# ═══════════════════════════════════════════════════════════

# ── Database ──
# Local: SQLite (file-based)
DATABASE_URL="file:./db/custom.db"

# Vercel/Turso Production: Uncomment below, comment out local
# DATABASE_URL="libsql://pu-alrms-turso-db.turso.io?authToken=your-turso-token"

# ── Authentication ──
# REQUIRED: Secret for signing JWTs used by the custom auth system.
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# REQUIRED in production: Secret for signing NextAuth session cookies.
# Generate with: openssl rand -base64 32
# In development, a fallback is used if not set.
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production"

# URL of your app. Must match the origin NextAuth sees in requests.
# In development: http://localhost:3000
# On Vercel: set to your production URL (e.g. https://your-app.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (REQUIRED for Google sign-in) ──
# Both variables below are required for Google OAuth to work.
# Without them, Google sign-in will be disabled.
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Phone OTP (optional — for production SMS) ──
# Twilio: https://www.twilio.com
TWILIO_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE=""

# ── AI (optional) ──
OPENAI_API_KEY=""

# ── App Config ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PU-ALRMS"
