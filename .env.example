# ═══════════════════════════════════════════════════════════
# PU-ALRMS — Environment Variables
# Copy this file to .env.local and fill in your values
# ═══════════════════════════════════════════════════════════

# ── Database (Postgres / Neon) ──
# Neon provides two connection URLs:
#   DATABASE_URL         → Pooled connection (for app runtime / serverless)
#   DIRECT_DATABASE_URL  → Direct connection (for migrations / prisma db push)
#
# Get a free Neon database at: https://neon.tech
#
# Example (Neon):
#   DATABASE_URL="postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require"
#   DIRECT_DATABASE_URL="postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require"
#
# Example (Vercel Postgres):
#   DATABASE_URL="postgres://default:xxx@ep-xxx-pooler.us-east-1.postgres.vercel-storage.com/verceldb?sslmode=require"
#   DIRECT_DATABASE_URL="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com/verceldb?sslmode=require"

DATABASE_URL=""
DIRECT_DATABASE_URL=""

# ── Authentication ──
# REQUIRED: Generate with: openssl rand -base64 32
JWT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (REQUIRED for Google sign-in) ──
# Get from: https://console.cloud.google.com/apis/credentials
# Add redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Super Admin ──
# Only this email gets SUPER_ADMIN role on first Google sign-in.
# Must be set before the user logs in for the first time.
SUPER_ADMIN_EMAIL=""

# ── Phone OTP (optional) ──
TWILIO_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE=""

# ── AI (optional) ──
OPENAI_API_KEY=""

# ── App Config ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PU-ALRMS"

# ── Database Adapter (optional) ──
# Set to "true" to force Neon adapter (even if URL doesn't contain neon.tech)
USE_NEON_ADAPTER=""
