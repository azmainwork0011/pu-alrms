# ═══════════════════════════════════════════════════════════
# PU-ALRMS — Environment Variables
# Copy this file to .env.local and fill in your values
# ═══════════════════════════════════════════════════════════

# ── Database ──
# Local development (SQLite file):
#   DATABASE_URL=file:./db/dev.db
#
# Production (Turso / LibSQL):
#   DATABASE_URL=libsql://your-db-name-your-org.turso.io
#   DATABASE_AUTH_TOKEN=your-turso-auth-token
#
# Get a Turso database: https://turso.tech
# Auth token from: turso db tokens create your-db-name

DATABASE_URL="file:./db/dev.db"
DATABASE_AUTH_TOKEN=""

# ── Authentication ──
# REQUIRED: Generate with: openssl rand -base64 32
JWT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (REQUIRED for Google sign-in) ──
# Get from: https://console.cloud.google.com/apis/credentials
# Add redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Super Admin ──
# Only this email gets SUPER_ADMIN role on first Google sign-in.
# Must be set before the user logs in for the first time.
SUPER_ADMIN_EMAIL=""

# ── AI Providers (multi-provider with fallback) ──
# At least ONE provider must be configured for AI to work.
# Fallback order: Gemini → Groq → OpenRouter

# Google Gemini (primary — free, best for academic tasks)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Groq (ultra-fast coding & chat — free tier available)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=""

# OpenRouter (fallback — free/open models)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# ── Phone OTP (optional) ──
TWILIO_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE=""

# ── App Config ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PU-ALRMS"
